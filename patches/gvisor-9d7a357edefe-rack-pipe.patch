+func TestVojetoRACKPipeTracksLostAndRetransmittedPackets(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		rack        bool
+		lost        [2]bool
+		transmitted uint32
+		high        seqnum.Value
+		want        int
+	}{
+		{"rack_lost", true, [2]bool{true, true}, 1, 99, 0},
+		{"rack_mixed", true, [2]bool{true, false}, 1, 99, 1},
+		{"rack_inflight", true, [2]bool{}, 1, 99, 2},
+		{"rack_retransmitted_once", true, [2]bool{}, 2, 2499, 2},
+		{"sack_existing_accounting", false, [2]bool{}, 2, 2499, 4},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ep := &Endpoint{}
+			ep.SACKPermitted = true
+			ep.scoreboard = NewSACKScoreboard(1200, 100)
+			if tc.rack {
+				ep.tcpRecovery = tcpip.TCPRACKLossDetection
+			}
+			s := &sender{ep: ep}
+			s.FastRecovery.Active = true
+			s.FastRecovery.HighRxt = tc.high
+			s.SndUna = 100
+			s.SndNxt = 2500
+			for i := 0; i < 2; i++ {
+				seg := &segment{pkt: stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 1200))}), sequenceNumber: seqnum.Value(100 + i*1200), flags: header.TCPFlagAck, xmitCount: tc.transmitted, lost: tc.lost[i]}
+				s.writeList.PushBack(seg)
+				defer seg.pkt.DecRef()
+			}
+			s.SetPipe()
+			if s.Outstanding != tc.want {
+				t.Fatalf("pipe=%d, want %d", s.Outstanding, tc.want)
+			}
+		})
+	}
+}
+
+func TestVojetoRACKRecoveryRefreshesPipeBeforeWindowCheck(t *testing.T) {
+	ep := &Endpoint{}
+	ep.SACKPermitted = true
+	ep.tcpRecovery = tcpip.TCPRACKLossDetection
+	ep.scoreboard = NewSACKScoreboard(1200, 100)
+	s := &sender{ep: ep, state: tcpip.SACKRecovery}
+	s.SndUna, s.SndNxt, s.Outstanding, s.SndCwnd, s.RTO = 100, 1300, 40, 0, time.Second
+	s.FastRecovery.Active, s.FastRecovery.HighRxt = true, 99
+	s.resendTimer.init(tcpip.NewStdClock(), func() {})
+	defer s.resendTimer.cleanup()
+	seg := &segment{pkt: stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 1200))}), sequenceNumber: 100, flags: header.TCPFlagAck, xmitCount: 1, lost: true}
+	s.writeList.PushBack(seg)
+	defer seg.pkt.DecRef()
+	// A zero congestion window prevents emission. Pipe still must reflect the
+	// newly declared loss rather than retain stale pre-recovery accounting.
+	rc := &rackControl{snd: s}
+	rc.DoRecovery(nil, false)
+	if s.Outstanding != 0 {
+		t.Fatalf("recovery retained stale pipe=%d", s.Outstanding)
+	}
+}
