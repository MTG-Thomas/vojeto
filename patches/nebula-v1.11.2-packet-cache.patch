@@ -0,0 +1,58 @@
+package nebula
+
+import (
+	"github.com/slackhq/nebula/header"
+	"io"
+	"log/slog"
+	"sync"
+	"testing"
+)
+
+func TestPacketCacheConcurrentCountAndTransfer(t *testing.T) {
+	hh := &HandshakeHostInfo{}
+	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+	start := make(chan struct{})
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		<-start
+		for i := 0; i < 50; i++ {
+			hh.cachePacket(logger, header.Message, 0, []byte{byte(i)}, nil, nil)
+		}
+		close(done)
+	}()
+	go func() {
+		defer wg.Done()
+		<-start
+		for {
+			select {
+			case <-done:
+				return
+			default:
+				hh.packetCount()
+			}
+		}
+	}()
+	close(start)
+	wg.Wait()
+	if hh.packetCount() != 50 {
+		t.Fatal("pending packets lost")
+	}
+	packets := hh.takePackets()
+	if hh.packetCount() != 0 || len(packets) != 50 {
+		t.Fatal("detach did not preserve and clear buffer")
+	}
+	next := &HandshakeHostInfo{}
+	next.replacePackets(packets)
+	received := next.takePackets()
+	if next.packetCount() != 0 || len(received) != 50 {
+		t.Fatal("transfer lost packets")
+	}
+	for i, packet := range received {
+		if len(packet.packet) != 1 || packet.packet[0] != byte(i) {
+			t.Fatal("cached payload changed")
+		}
+	}
+}
