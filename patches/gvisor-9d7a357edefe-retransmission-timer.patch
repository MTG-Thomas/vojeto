+package tcp
+
+import (
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/seqnum"
+	"testing"
+	"time"
+)
+
+func TestVojetoTailProbeArmsRetransmissionWithZeroPipe(t *testing.T) {
+	s := sender{}
+	s.SndUna, s.SndNxt = seqnum.Value(100), seqnum.Value(3700)
+	s.Outstanding, s.SndWnd, s.RTO = 0, 65536, 200*time.Millisecond
+	clock := tcpip.NewStdClock()
+	s.resendTimer.init(clock, func() {})
+	s.probeTimer.init(clock, func() {})
+	defer s.resendTimer.cleanup()
+	defer s.probeTimer.cleanup()
+	s.postXmit(false, false)
+	if !s.resendTimer.enabled() {
+		t.Fatal("unacknowledged data has no retransmission timer after tail probe")
+	}
+	if s.probeTimer.enabled() {
+		t.Fatal("tail probe was rescheduled instead of retransmission")
+	}
+}
